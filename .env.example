# Copy to .env.local (ignored by git) and adjust. Restart `npx expo start` after changing it.

# Address of the multiplayer server (the separate QuestClashServer project). On a phone, use your computer's LAN
# address, not localhost: "localhost" on the phone is the phone itself.
# EXPO_PUBLIC_ values are compiled into the app in plain text: fine for an address,
# never for a secret.
# EXPO_PUBLIC_GAME_SERVER_URL=http://192.168.1.20:2567
