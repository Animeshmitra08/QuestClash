{
  "expo": {
    "name": "QuestClash",
    "slug": "QuestClash",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/QuestClash.png",
    "scheme": "questclash",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aondigicon.questclash"
    },
    "android": {
      "package": "com.aondigicon.questclash",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/background&foreground.png",
        "backgroundImage": "./assets/images/background&foreground.png",
        "monochromeImage": "./assets/images/Monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#120d1f",
          "image": "./assets/images/QuestClash.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#120d1f",
            "image": "./assets/images/QuestClash.png"
          }
        }
      ],
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "hidden": true
      },
      "eas": {
        "projectId": "3bb92c17-f97b-4cb9-b3fc-99436f00fc91"
      }
    }
  }
}
